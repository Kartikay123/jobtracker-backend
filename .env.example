# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# --- Database ---
# Inside docker-compose, host is "db"; for local dev outside docker, use "localhost"
DATABASE_URL=postgresql+asyncpg://jt:jt@db:5432/jobtracker

# --- Redis ---
# Inside docker-compose, host is "redis"; for local dev outside docker, use "localhost"
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5173

# --- Postgres (used by docker-compose for the db container) ---
POSTGRES_USER=jt
POSTGRES_PASSWORD=jt
POSTGRES_DB=jobtracker
